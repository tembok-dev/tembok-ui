{
  "name": "tembok-ui",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tembok-dev/tembok-ui.git"
  },
  "homepage": "https://github.com/tembok-dev/tembok-ui#readme",
  "bugs": {
    "url": "https://github.com/tembok-dev/tembok-ui/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "typecheck": "pnpm -r --filter ./packages/** run typecheck",
    "clean": "rimraf \"packages/*/dist\"",
    "dev": "pnpm --filter @tembok/playground dev",
    "playground:build": "pnpm --filter @tembok/playground build",
    "playground:typecheck": "pnpm --filter @tembok/playground typecheck",
    "test": "pnpm --filter @tembok/playground test",
    "check": "pnpm typecheck && pnpm playground:typecheck && pnpm test && pnpm build && pnpm playground:build",
    "consumer:check": "node scripts/consumer-smoke.mjs"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.0.0"
}
